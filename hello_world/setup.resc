## ESP32-C3 hello_world setup script (used by test.robot)
## Loads firmware and configures emulation; does NOT start emulation.
## The Boot And Kick keyword in test.robot handles CLIC setup and boot phases.

$base?="/home/tim/github/mithro/renode-espemu"
$rom_elf?="/home/tim/esp/esp-rom-elfs/esp32c3_rev3_rom.elf"

using sysbus
include $base/peripherals/interrupt-matrix/ESP32C3_InterruptMatrix.cs
include $base/peripherals/efuse/ESP32C3_eFuse.cs
include $base/peripherals/rtc/ESP32C3_RTC.cs
include $base/peripherals/systimer/ESP32C3_SysTimer.cs
include $base/peripherals/timer-group/ESP32C3_TimerGroup.cs
include $base/peripherals/system/ESP32C3_System.cs
include $base/peripherals/rng/ESP32C3_RNG.cs
include $base/peripherals/gpio/ESP32C3_GPIO.cs
include $base/peripherals/extmem/ESP32C3_ExtMem.cs
include $base/peripherals/uart/ESP32C3_UART.cs
include $base/peripherals/iomux/ESP32C3_IOMUX.cs
include $base/peripherals/spi-flash/ESP32C3_SpiMem.cs
include $base/peripherals/sensitive/ESP32C3_Sensitive.cs
include $base/peripherals/gdma/ESP32C3_GDMA.cs
include $base/peripherals/assist-debug/ESP32C3_AssistDebug.cs
include $base/peripherals/mmu/ESP32C3_MMU.cs
mach create "esp32c3"
machine LoadPlatformDescription $base/platforms/cpus/esp32c3.repl

sysbus LoadELF $rom_elf
sysbus LoadELF $base/hello_world/firmware/hello_world.elf
sysbus LoadBinary $base/hello_world/firmware/flash_header_128k.bin 0x3C000000
sysbus LoadBinary $base/hello_world/firmware/hello_world.bin 0x3C020000
sysbus LoadBinary $base/platforms/rom_data_segment.bin 0x3FF00000
sysbus LoadBinary $base/platforms/rom_iram_data.bin 0x40059590


# Start at ROM _init — CRT0 initializes DRAM naturally
cpu PC 0x40001E90
set skip_rom_main
"""
from Antmicro.Renode.Peripherals.CPU import RegisterValue
cpu.PC = RegisterValue.Create(0x403802DC, 32)
"""
cpu AddHook 0x40047E3C $skip_rom_main

# Cycle counter CSR 0x802: returns cpu.ExecutedInstructions for delay functions
set cycle_counter_handler
"""
if request.IsRead:
    request.Value = cpu.ExecutedInstructions
"""
cpu RegisterCSRHandlerFromString 0x802 $cycle_counter_handler

