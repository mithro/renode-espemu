sysbus WriteByte 0x2000105E 0x00
sysbus WriteByte 0x2000105F 0xFF
sysbus WriteByte 0x20001061 0x01
sysbus WriteByte 0x20001062 0x00
sysbus WriteByte 0x20001063 0xFF
sysbus WriteByte 0x20001065 0x01
sysbus WriteByte 0x20001066 0x00
sysbus WriteByte 0x20001067 0xFF
sysbus WriteByte 0x20001069 0x01
sysbus WriteByte 0x2000106A 0x00
