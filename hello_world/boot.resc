using sysbus
include @/home/tim/github/mithro/renode-espemu/peripherals/interrupt-matrix/ESP32C3_InterruptMatrix.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/efuse/ESP32C3_eFuse.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/rtc/ESP32C3_RTC.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/systimer/ESP32C3_SysTimer.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/timer-group/ESP32C3_TimerGroup.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/system/ESP32C3_System.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/rng/ESP32C3_RNG.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/gpio/ESP32C3_GPIO.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/extmem/ESP32C3_ExtMem.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/uart/ESP32C3_UART.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/iomux/ESP32C3_IOMUX.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/spi-flash/ESP32C3_SpiMem.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/sensitive/ESP32C3_Sensitive.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/gdma/ESP32C3_GDMA.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/assist-debug/ESP32C3_AssistDebug.cs
include @/home/tim/github/mithro/renode-espemu/peripherals/mmu/ESP32C3_MMU.cs
mach create "esp32c3"
machine LoadPlatformDescription @/home/tim/github/mithro/renode-espemu/platforms/cpus/esp32c3.repl

sysbus LoadELF @/home/tim/esp/esp-rom-elfs/esp32c3_rev3_rom.elf
sysbus LoadELF @/home/tim/github/mithro/renode-espemu/hello_world/firmware/hello_world.elf
sysbus LoadBinary @/home/tim/github/mithro/renode-espemu/hello_world/firmware/flash_header_128k.bin 0x3C000000
sysbus LoadBinary @/home/tim/github/mithro/renode-espemu/hello_world/firmware/hello_world.bin 0x3C020000
sysbus LoadBinary @/home/tim/github/mithro/renode-espemu/platforms/rom_data_segment.bin 0x3FF00000
cpu SP 0x3FCDE710
sysbus LoadBinary @/home/tim/github/mithro/renode-espemu/platforms/rom_func_stubs.bin 0x50001D00

# Patch rom function tables and spiflash data after BSS clear
cpu AddHook 0x40380338 "machine.SystemBus.WriteDoubleWord(0x3FCDF5B8, 0x50001D00); machine.SystemBus.WriteDoubleWord(0x3FCDFFD4, 0x50001D00); machine.SystemBus.WriteDoubleWord(0x3FCDFFF0, 0x50001E00)"

# Pre-populate rom_spiflash_legacy_data at 0x50001E00
sysbus WriteDoubleWord 0x50001E00 0x001640EF
sysbus WriteDoubleWord 0x50001E04 0x00400000
sysbus WriteDoubleWord 0x50001E08 0x00010000
sysbus WriteDoubleWord 0x50001E0C 0x00001000
sysbus WriteDoubleWord 0x50001E10 0x00000100
sysbus WriteDoubleWord 0x50001E14 0x0000FFFF
sysbus WriteDoubleWord 0x50001E18 0x00000000

# Cycle counter CSR 0x802: returns cpu.ExecutedInstructions for delay functions
set cycle_counter_handler
"""
if request.IsRead:
    request.Value = cpu.ExecutedInstructions
"""
cpu RegisterCSRHandlerFromString 0x802 $cycle_counter_handler

# Re-patch rom_cache_internal_table_ptr after memprot init overwrites it.
# The memprot code (0x403804B2–0x403804E4) runs the PMS configuration which
# also writes to DRAM, overwriting the ROM table stub installed at 0x40380338.
# This hook fires immediately after memprot returns and restores the pointer.
cpu AddHook 0x403804E4 "machine.SystemBus.WriteDoubleWord(0x3FCDFFD4, 0x50001D00)"

# Boot with CLIC present but unconfigured
start
sleep 1
pause

# Configure CLIC interrupt delivery
cpu MTVEC 0x40380003

# CLIC dispatch hook: interrupts -> _interrupt_handler, exceptions -> firmware
set dispatch_clic
"""
from Antmicro.Renode.Peripherals.CPU import RegisterValue
mcause = cpu.MCAUSE.RawValue
if mcause & 0x80000000:
    cpu.PC = RegisterValue.Create(0x403801DC, 32)
"""
cpu AddHook 0x40380000 $dispatch_clic

# Enable all 32 CLIC interrupts: level-triggered, SHV=0, max priority
sysbus WriteByte 0x20001001 0x01
sysbus WriteByte 0x20001002 0x00
sysbus WriteByte 0x20001003 0xFF
sysbus WriteByte 0x20001005 0x01
sysbus WriteByte 0x20001006 0x00
sysbus WriteByte 0x20001007 0xFF
sysbus WriteByte 0x20001009 0x01
