sysbus WriteByte 0x2000107A 0x00
sysbus WriteByte 0x2000107B 0xFF
sysbus WriteByte 0x2000107D 0x01
sysbus WriteByte 0x2000107E 0x00
sysbus WriteByte 0x2000107F 0xFF

cpu WfiAsNop true

# CLIC delivers systimer interrupts naturally — no manual kick needed
start
sleep 4
pause
