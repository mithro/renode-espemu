// ESP32-C3 Platform Definition for Renode
//
// Based on ESP-IDF v5.4.1 components/soc/esp32c3/register/soc/reg_base.h
// and components/soc/esp32c3/include/soc/soc.h
//
// Memory map and peripheral addresses for the ESP32-C3 (RISC-V RV32IMC)

// === CPU ===

cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32imc_zicsr_zifencei"
    privilegedArchitecture: PrivilegedArchitecture.Priv1_10
    timeProvider: clint
    init:
        RegisterCustomCSR "MPCER" 0x7E2 Machine
        RegisterCustomCSR "MPCMR" 0x7E3 Machine
        RegisterCustomCSR "PMAADDR0" 0x800 Machine
        RegisterCustomCSR "PMAADDR1" 0x801 Machine
        RegisterCustomCSR "PMACFG0" 0x802 Machine

// CLINT (Core Local Interruptor) for timer interrupts.
// IRQ 3 = software interrupt, IRQ 7 = timer interrupt (needed for FreeRTOS tick)
clint: IRQControllers.CoreLevelInterruptor @ sysbus 0x60801000
    frequency: 16000000
    [0, 1] -> cpu@[3, 7]

// === WORKAROUND MEMORY ===

// Null-pointer dereference guard: ROM code (rom_i2c_writeReg_Mask) reads
// through a function table pointer (rom_phyFuns at 0x3FCDF5B8) that is
// uninitialised (zero) in emulation. This causes reads from low addresses
// (0x0-0x1FFF) and eventual jump to PC=0x0. Mapping a small region here
// prevents CPU abort and lets the firmware continue past these calls.
// TODO: Replace with proper rom_phyFuns initialisation when PHY stubs are added.
null_guard: Memory.MappedMemory @ sysbus 0x0
    size: 0x2000

// === MEMORY REGIONS ===

// Internal SRAM (used as both IRAM and DRAM)
// DRAM: 0x3FC70000 - 0x3FCE0000 (448 KB -- extended below nominal 0x3FC80000 to catch stack)
// IRAM: 0x40370000 - 0x403E0000 (mapped as alias of DRAM)
// The ESP32-C3 physical SRAM is 400KB; we over-provision slightly to avoid
// stack underflow crashes. The firmware's linker may set SP above our nominal boundary.
dram: Memory.MappedMemory @ {
        sysbus 0x3FC70000;
        sysbus 0x40370000
    }
    size: 0x70000

// Internal ROM (boot ROM)
// The ESP32-C3 ROM is 384KB of physical memory, accessible via two bus views:
// - Instruction bus: 0x40000000 - 0x4005FFFF (full 384 KB)
// - Data bus: 0x3FF00000 - 0x3FF1FFFF (last 128 KB, i.e. ROM offset 0x40000+)
// The data bus view at 0x3FF00000 maps to the same physical memory as
// 0x40040000 on the instruction bus.
//
// We create a 384KB memory at the instruction bus address, then separately
// map the data-bus alias. Since Renode doesn't support offset aliases directly,
// we use two separate memories and copy the ROM data segment via LoadBinary in .resc.
irom_mask: Memory.MappedMemory @ sysbus 0x40000000
    size: 0x60000

drom_mask: Memory.MappedMemory @ sysbus 0x3FF00000
    size: 0x20000

// Flash cache windows (mapped by MMU, stubbed as flat memory for now)
// DROM: 0x3C000000 - 0x3C800000 (8 MB)
// IROM: 0x42000000 - 0x42800000 (8 MB)
drom: Memory.MappedMemory @ sysbus 0x3C000000
    size: 0x800000

irom: Memory.MappedMemory @ sysbus 0x42000000
    size: 0x800000

// RTC slow memory
// 0x50000000 - 0x50002000 (8 KB)
rtc_slow: Memory.MappedMemory @ sysbus 0x50000000
    size: 0x2000

// === PERIPHERALS ===

// UART0 (console) at 0x60000000
// Python-based ESP32-C3 UART stub: writes to FIFO (offset 0x0) output chars,
// STATUS (offset 0x1C) reports TX FIFO empty so firmware doesn't block.
uart0: Python.PythonPeripheral @ sysbus 0x60000000
    size: 0x100
    initable: true
    filename: "/home/tim/github/mithro/renode-espemu/platforms/scripts/esp32c3_uart.py"

// === STUB PERIPHERALS ===
// Python catch-all peripherals for unimplemented register ranges.
// These return 0 on read, absorb writes, and log all accesses.
// As real peripherals are implemented, they replace these stubs.

// SPI1 (flash controller) at 0x60002000
stub_spi1: Python.PythonPeripheral @ sysbus 0x60002000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// SPI0 at 0x60003000
stub_spi0: Python.PythonPeripheral @ sysbus 0x60003000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// FE2 (RF Frontend 2) at 0x60005000
stub_fe2: Python.PythonPeripheral @ sysbus 0x60005000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// FE (RF Frontend) at 0x60006000
stub_fe: Python.PythonPeripheral @ sysbus 0x60006000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// RTC I2C at 0x6000E000
stub_rtc_i2c: Python.PythonPeripheral @ sysbus 0x6000E000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// NRX at 0x6001C000
stub_nrx: Python.PythonPeripheral @ sysbus 0x6001C000
    size: 0x2000
    initable: true
    script: "request.Value = 0x0"

// BB (Baseband) at 0x6001D000 - already covered by NRX range above if overlapping
// Adding explicit stub for safety
stub_bb: Python.PythonPeripheral @ sysbus 0x6001E000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// GPIO at 0x60004000
stub_gpio: Python.PythonPeripheral @ sysbus 0x60004000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// RTC Controller at 0x60008000
// Offset 0x38 = RTC_CNTL_RESET_STATE_REG: return POWERON_RESET (1) for CPU0
stub_rtc: Python.PythonPeripheral @ sysbus 0x60008000
    size: 0x800
    initable: true
    filename: "/home/tim/github/mithro/renode-espemu/platforms/scripts/stub_rtc.py"

// eFuse at 0x60008800
stub_efuse: Python.PythonPeripheral @ sysbus 0x60008800
    size: 0x800
    initable: true
    script: "request.Value = 0x0"

// IO MUX at 0x60009000
stub_io_mux: Python.PythonPeripheral @ sysbus 0x60009000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// UART1 at 0x60010000
stub_uart1: Python.PythonPeripheral @ sysbus 0x60010000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// I2C at 0x60013000
stub_i2c: Python.PythonPeripheral @ sysbus 0x60013000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// UHCI0 at 0x60014000
stub_uhci0: Python.PythonPeripheral @ sysbus 0x60014000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// RMT at 0x60016000
stub_rmt: Python.PythonPeripheral @ sysbus 0x60016000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// LEDC at 0x60019000
stub_ledc: Python.PythonPeripheral @ sysbus 0x60019000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// Timer Group 0 at 0x6001F000
// Offset 0x68 = TIMG_RTCCALICFG_REG: bit 15 = RTC_CALI_RDY (calibration done)
// Offset 0x6C = TIMG_RTCCALICFG1_REG: calibration result value
stub_timg0: Python.PythonPeripheral @ sysbus 0x6001F000
    size: 0x1000
    initable: true
    filename: "/home/tim/github/mithro/renode-espemu/platforms/scripts/stub_timg0.py"

// Timer Group 1 at 0x60020000
stub_timg1: Python.PythonPeripheral @ sysbus 0x60020000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// System Timer at 0x60023000
// Returns incrementing counter and valid-latch bit for FreeRTOS tick
stub_systimer: Python.PythonPeripheral @ sysbus 0x60023000
    size: 0x1000
    initable: true
    filename: "/home/tim/github/mithro/renode-espemu/platforms/scripts/stub_systimer.py"

// SPI2 (GP-SPI) at 0x60024000
stub_spi2: Python.PythonPeripheral @ sysbus 0x60024000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// SYSCON at 0x60026000
stub_syscon: Python.PythonPeripheral @ sysbus 0x60026000
