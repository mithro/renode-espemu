    script: "request.Value = 0x0"

// System registers (SYSTEM) at 0x600C0000
// CPU_INTR_FROM_CPU_0 at offset 0x28: immediately cleared for vPortYield
stub_system: Python.PythonPeripheral @ sysbus 0x600C0000
    size: 0x1000
    initable: true
    filename: "/home/tim/github/mithro/renode-espemu/platforms/scripts/stub_system.py"

// Sensitive registers at 0x600C1000
stub_sensitive: Python.PythonPeripheral @ sysbus 0x600C1000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// Interrupt Matrix at 0x600C2000
// C# peripheral: routes 64 peripheral sources to 32 CPU interrupt lines
intmatrix: IRQControllers.ESP32C3_InterruptMatrix @ sysbus 0x600C2000
    // Wire CPU interrupt outputs to CPU (lines 1-31)
    [1-31] -> cpu@[1-31]

// External Memory (cache control) at 0x600C4000
// Returns cache done/ready status bits for suspend/sync operations
stub_extmem: Python.PythonPeripheral @ sysbus 0x600C4000
    size: 0x1000
    initable: true
    filename: "/home/tim/github/mithro/renode-espemu/platforms/scripts/stub_extmem.py"

// MMU Table at 0x600C5000
stub_mmu: Python.PythonPeripheral @ sysbus 0x600C5000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// XTS-AES at 0x600CC000
stub_xts_aes: Python.PythonPeripheral @ sysbus 0x600CC000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

