// ESP32-C3 Platform Definition for Renode
//
// Based on ESP-IDF v5.4.1 components/soc/esp32c3/register/soc/reg_base.h
// and components/soc/esp32c3/include/soc/soc.h
//
// Memory map and peripheral addresses for the ESP32-C3 (RISC-V RV32IMC)

// === CPU ===

cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32imc_zicsr_zifencei"
    privilegedArchitecture: PrivilegedArchitecture.Priv1_10
    timeProvider: clint

// CLINT (Core Local Interruptor) for timer interrupts
clint: IRQControllers.CoreLevelInterruptor @ sysbus 0x60801000
    frequency: 16000000
    [0, 1] -> cpu@[3, 7]

// === MEMORY REGIONS ===

// Internal SRAM (used as both IRAM and DRAM)
// DRAM: 0x3FC80000 - 0x3FCE0000 (384 KB)
dram: Memory.MappedMemory @ {
        sysbus 0x3FC80000;
        sysbus 0x40380000
    }
    size: 0x60000

// Internal ROM (boot ROM)
// 0x3FF00000 - 0x3FF1FFFF (128 KB, data view)
// 0x40000000 - 0x4005FFFF (384 KB, instruction view)
drom_mask: Memory.MappedMemory @ sysbus 0x3FF00000
    size: 0x20000

irom_mask: Memory.MappedMemory @ sysbus 0x40000000
    size: 0x60000

// Flash cache windows (mapped by MMU, stubbed as flat memory for now)
// DROM: 0x3C000000 - 0x3C800000 (8 MB)
// IROM: 0x42000000 - 0x42800000 (8 MB)
drom: Memory.MappedMemory @ sysbus 0x3C000000
    size: 0x800000

irom: Memory.MappedMemory @ sysbus 0x42000000
    size: 0x800000

// RTC slow memory
// 0x50000000 - 0x50002000 (8 KB)
rtc_slow: Memory.MappedMemory @ sysbus 0x50000000
    size: 0x2000

// === PERIPHERALS ===

// UART0 (console) at 0x60000000
// Using LiteX_UART as a simple stub since ESP32_UART is not in this Renode release
uart0: UART.LiteX_UART @ sysbus 0x60000000

// === STUB PERIPHERALS ===
// Python catch-all peripherals for unimplemented register ranges.
// These return 0 on read, absorb writes, and log all accesses.
// As real peripherals are implemented, they replace these stubs.

// SPI1 (flash controller) at 0x60002000
stub_spi1: Python.PythonPeripheral @ sysbus 0x60002000
    size: 0x1000
    initable: true
    script: "request.value = 0x0"

// SPI0 at 0x60003000
stub_spi0: Python.PythonPeripheral @ sysbus 0x60003000
    size: 0x1000
    initable: true
    script: "request.value = 0x0"

// GPIO at 0x60004000
stub_gpio: Python.PythonPeripheral @ sysbus 0x60004000
    size: 0x1000
    initable: true
    script: "request.value = 0x0"

// RTC Controller at 0x60008000
stub_rtc: Python.PythonPeripheral @ sysbus 0x60008000
    size: 0x800
    initable: true
    script: "request.value = 0x0"

// eFuse at 0x60008800
stub_efuse: Python.PythonPeripheral @ sysbus 0x60008800
    size: 0x800
    initable: true
    script: "request.value = 0x0"

// IO MUX at 0x60009000
stub_io_mux: Python.PythonPeripheral @ sysbus 0x60009000
