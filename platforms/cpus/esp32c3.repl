// ESP32-C3 Platform Definition for Renode
//
// Based on ESP-IDF v5.4.1 components/soc/esp32c3/register/soc/reg_base.h
// and components/soc/esp32c3/include/soc/soc.h
//
// Memory map and peripheral addresses for the ESP32-C3 (RISC-V RV32IMC)

// === CPU ===

cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32imc_zicsr_zifencei"
    privilegedArchitecture: PrivilegedArchitecture.PrivUnratified
    timeProvider: clint
    init:
        // ROM _init writes csrw 0x000 (USTATUS) — must not trap
        RegisterCustomCSR "USTATUS" 0x000 Machine
        RegisterCustomCSR "MPCER" 0x7E2 Machine
        RegisterCustomCSR "MPCMR" 0x7E3 Machine
        RegisterCustomCSR "PMAADDR0" 0x800 Machine
        RegisterCustomCSR "PMAADDR1" 0x801 Machine

// CLINT (Core Local Interruptor) for timer interrupts.
// Wired through CLIC for unified interrupt delivery.
clint: IRQControllers.CoreLevelInterruptor @ sysbus 0x60801000
    frequency: 16000000
    [0, 1] -> clic@[3, 7]

// CLIC for interrupt delivery with correct mcause
clic: IRQControllers.CoreLocalInterruptController @ {
        sysbus <0x20000000, +0x10000>;
        cpu <0x1000, +0x4A1>
    }
    cpu: cpu
    numberOfInterrupts: 32
    machineLevelBits: 4
    supervisorLevelBits: 0
    modeBits: 0

// === MEMORY REGIONS ===

// Internal SRAM (used as both IRAM and DRAM)
// DRAM: 0x3FC70000 - 0x3CE10000 (480 KB -- extended to cover stack/heap overflow reads)
// IRAM: 0x40370000 - 0x403E0000 (mapped as alias of DRAM)
// The ESP32-C3 physical SRAM is 400KB; we over-provision to avoid crashes from
// firmware reads past nominal boundaries (seen at 0x3FCE0000+ during boot).
dram: Memory.MappedMemory @ {
        sysbus 0x3FC70000;
        sysbus 0x40370000
    }
    size: 0x78000

// Internal ROM (boot ROM)
// The ESP32-C3 ROM is 384KB of physical memory, accessible via two bus views:
// - Instruction bus: 0x40000000 - 0x4005FFFF (full 384 KB)
// - Data bus: 0x3FF00000 - 0x3FF1FFFF (last 128 KB, i.e. ROM offset 0x40000+)
// The data bus view at 0x3FF00000 maps to the same physical memory as
// 0x40040000 on the instruction bus.
//
// We create a 384KB memory at the instruction bus address, then separately
// map the data-bus alias. Since Renode doesn't support offset aliases directly,
// we use two separate memories and copy the ROM data segment via LoadBinary in .resc.
irom_mask: Memory.MappedMemory @ sysbus 0x40000000
    size: 0x60000

drom_mask: Memory.MappedMemory @ sysbus 0x3FF00000
    size: 0x20000

// Flash cache windows (mapped by MMU, stubbed as flat memory for now)
// DROM: 0x3C000000 - 0x3C800000 (8 MB)
// IROM: 0x42000000 - 0x42800000 (8 MB)
drom: Memory.MappedMemory @ sysbus 0x3C000000
    size: 0x800000

irom: Memory.MappedMemory @ sysbus 0x42000000
    size: 0x800000

// RTC slow memory
// 0x50000000 - 0x50002000 (8 KB)
rtc_slow: Memory.MappedMemory @ sysbus 0x50000000
    size: 0x2000

// === PERIPHERALS ===

// UART0 (console) at 0x60000000
// C# UART extending UARTBase — works with Renode Terminal Tester
uart0: UART.ESP32C3_UART @ sysbus 0x60000000

// === PLACEHOLDER PERIPHERALS ===
// Python peripherals for unimplemented register ranges.
// Return 0 on read, absorb writes. Replaced with C# as implemented.

// SPI1 (flash controller) at 0x60002000
// C# peripheral: minimal SPI MEM for flash init (RDID, JEDEC ID)
spi1: Memory.ESP32C3_SpiMem @ sysbus 0x60002000

// SPI0 at 0x60003000
stub_spi0: Python.PythonPeripheral @ sysbus 0x60003000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// FE2 (RF Frontend 2) at 0x60005000
stub_fe2: Python.PythonPeripheral @ sysbus 0x60005000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// FE (RF Frontend) at 0x60006000
stub_fe: Python.PythonPeripheral @ sysbus 0x60006000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// RTC I2C at 0x6000E000
stub_rtc_i2c: Python.PythonPeripheral @ sysbus 0x6000E000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// NRX at 0x6001C000
stub_nrx: Python.PythonPeripheral @ sysbus 0x6001C000
    size: 0x2000
    initable: true
    script: "request.Value = 0x0"

// BB (Baseband) at 0x6001D000 - already covered by NRX range above if overlapping
// Adding explicit stub for safety
stub_bb: Python.PythonPeripheral @ sysbus 0x6001E000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// GPIO at 0x60004000
// C# peripheral: 22 pins, W1TS/W1TC registers, per-pin config, function mux.
// Numbered output 0 = aggregate GPIO interrupt -> interrupt-matrix source 16
// (ETS_GPIO_INTR_SOURCE on the ESP32-C3). A peripheral IRQ line attaches to a
// GPIO input pin as e.g. `radio: ... ; 0 -> gpio@4`.
gpio: GPIOPort.ESP32C3_GPIO @ sysbus 0x60004000
    0 -> intmatrix@16

// RTC Controller at 0x60008000
// RTC Controller at 0x60008000
// C# peripheral: reset state, RTC time, clock config, STORE registers, brownout
rtc: Miscellaneous.ESP32C3_RTC @ sysbus 0x60008000

// eFuse at 0x60008800
// C# peripheral: read-only OTP storage with MAC, chip revision, etc.
efuse: Miscellaneous.ESP32C3_eFuse @ sysbus 0x60008800

// IO MUX at 0x60009000
// C# peripheral: per-pin mux selection, pull-up/down, drive strength
iomux: Miscellaneous.ESP32C3_IOMUX @ sysbus 0x60009000

// UART1 at 0x60010000
stub_uart1: Python.PythonPeripheral @ sysbus 0x60010000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// I2C at 0x60013000
stub_i2c: Python.PythonPeripheral @ sysbus 0x60013000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// UHCI0 at 0x60014000
stub_uhci0: Python.PythonPeripheral @ sysbus 0x60014000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// RMT at 0x60016000
stub_rmt: Python.PythonPeripheral @ sysbus 0x60016000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// LEDC at 0x60019000
stub_ledc: Python.PythonPeripheral @ sysbus 0x60019000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// Timer Group 0 at 0x6001F000
// Offset 0x68 = TIMG_RTCCALICFG_REG: bit 15 = RTC_CALI_RDY (calibration done)
// Offset 0x6C = TIMG_RTCCALICFG1_REG: calibration result value
// Timer Group 0 at 0x6001F000
// C# peripheral: 54-bit counter, RTC calibration, alarm, WDT stub
timg0: Timers.ESP32C3_TimerGroup @ sysbus 0x6001F000

// Timer Group 1 at 0x60020000
timg1: Timers.ESP32C3_TimerGroup @ sysbus 0x60020000

// System Timer at 0x60023000
// C# peripheral: 16MHz counter, 3 alarm comparators, GPIO outputs to intmatrix
systimer: Timers.ESP32C3_SysTimer @ sysbus 0x60023000
    0 -> intmatrix@37
    1 -> intmatrix@38
    2 -> intmatrix@39

// SPI2 (GP-SPI / FSPI) at 0x60024000
// C# SPI master: clocks bytes to a connected ISPIPeripheral slave (attach a
// slave in a .repl as a child of spi2). Models the ESP-IDF spi_master CPU
// polling path (CMD/USER/MS_DLEN/W0..W15/DMA_INT_RAW). See peripherals/spi2/.
spi2: SPI.ESP32C3_SPI2 @ sysbus 0x60024000

// SYSCON at 0x60026000 (includes WDEV_RND_REG at offset 0xB0 for RNG)
// C# peripheral: xorshift32 PRNG at offset 0xB0, pass-through for other regs
syscon: Miscellaneous.ESP32C3_RNG @ sysbus 0x60026000

// TWAI at 0x6002B000
stub_twai: Python.PythonPeripheral @ sysbus 0x6002B000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// I2S at 0x6002D000
stub_i2s: Python.PythonPeripheral @ sysbus 0x6002D000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// AES at 0x6003A000
stub_aes: Python.PythonPeripheral @ sysbus 0x6003A000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// SHA at 0x6003B000
stub_sha: Python.PythonPeripheral @ sysbus 0x6003B000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// RSA at 0x6003C000
stub_rsa: Python.PythonPeripheral @ sysbus 0x6003C000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// Digital Signature at 0x6003D000
stub_ds: Python.PythonPeripheral @ sysbus 0x6003D000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// HMAC at 0x6003E000
stub_hmac: Python.PythonPeripheral @ sysbus 0x6003E000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// GDMA at 0x6003F000
// C# peripheral: 3-channel DMA controller (register storage, no transfers)
gdma: DMA.ESP32C3_GDMA @ sysbus 0x6003F000

// APB SAR ADC at 0x60040000
stub_adc: Python.PythonPeripheral @ sysbus 0x60040000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// USB Serial/JTAG at 0x60043000
stub_usb: Python.PythonPeripheral @ sysbus 0x60043000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// System registers (SYSTEM) at 0x600C0000
// C# peripheral: clock gating, cross-core interrupts (FROM_CPU_INTR0-3)
system: Miscellaneous.ESP32C3_System @ sysbus 0x600C0000
    0 -> intmatrix@50
    1 -> intmatrix@51
    2 -> intmatrix@52
    3 -> intmatrix@53

// Sensitive (PMS) registers at 0x600C1000
// C# peripheral: permission management, lock bits, DMA/PIF access control
sensitive: Miscellaneous.ESP32C3_Sensitive @ sysbus 0x600C1000

// Interrupt Matrix at 0x600C2000
// C# peripheral: routes 64 peripheral sources to 32 CPU interrupt lines
intmatrix: IRQControllers.ESP32C3_InterruptMatrix @ sysbus 0x600C2000
    // Interrupt delivery via CLIC for correct mcause
    [0-31] -> clic@[0-31]

// External Memory (cache control) at 0x600C4000
// C# peripheral: ICache control, sync/preload done bits, cache state
extmem: Miscellaneous.ESP32C3_ExtMem @ sysbus 0x600C4000

// MMU Table at 0x600C5000
// C# peripheral: 128-entry page table for ICache/DCache flash mapping
mmu: Miscellaneous.ESP32C3_MMU @ sysbus 0x600C5000

// XTS-AES at 0x600CC000
stub_xts_aes: Python.PythonPeripheral @ sysbus 0x600CC000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"

// Assist Debug at 0x600CE000
// C# peripheral: SP monitoring, PC recording, exception logging
assist_debug: Miscellaneous.ESP32C3_AssistDebug @ sysbus 0x600CE000

// World Controller at 0x600D0000
stub_wcl: Python.PythonPeripheral @ sysbus 0x600D0000
    size: 0x1000
    initable: true
    script: "request.Value = 0x0"
